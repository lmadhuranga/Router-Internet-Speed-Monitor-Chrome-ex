              ]
            },
            "description": "Reads the current IPv4/IPv6 MAC access-rule list."
          }
        },
        {
          "name": "CMD 23 - Save IPv4 + IPv6 Access Rules",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "text/plain, */*; q=0.01"
              },
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "Referer",
                "value": "{{baseUrl}}/mindex.html"
              },
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cmd\": 23,\n  \"method\": \"POST\",\n  \"success\": true,\n  \"datas\": [\n    {\n      \"enableRule\": true,\n      \"enableLink\": true,\n      \"remark\": \"Example IPv6 rule\",\n      \"ippro\": \"IPV6\",\n      \"mac\": \"{{mac}}\"\n    },\n    {\n      \"enableRule\": true,\n      \"enableLink\": false,\n      \"remark\": \"Example IPv4 rule\",\n      \"ippro\": \"IPV4\",\n      \"mac\": \"{{mac}}\"\n    }\n  ],\n  \"language\": \"EN\",\n  \"sessionId\": \"{{sessionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cgi-bin/http.cgi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cgi-bin",
                "http.cgi"
              ]
            },
            "description": "Saves the full desired rule list. enableLink=true allows; false blocks. After successful CMD 23, run CMD 20."
          }
        },
        {
          "name": "CMD 23 - Delete Rule by Omission",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "text/plain, */*; q=0.01"
              },
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
