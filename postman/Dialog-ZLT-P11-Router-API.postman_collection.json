                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cmd\": 23,\n  \"method\": \"POST\",\n  \"success\": true,\n  \"datas\": [\n    {\n      \"enableRule\": true,\n      \"enableLink\": false,\n      \"remark\": \"Example IPv4 rule\",\n      \"ippro\": \"IPV4\",\n      \"mac\": \"{{mac}}\"\n    }\n  ],\n  \"language\": \"EN\",\n  \"sessionId\": \"{{sessionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
