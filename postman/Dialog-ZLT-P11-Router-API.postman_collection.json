    },
    {
      "name": "LTE / Cell Diagnostics",
      "item": [
        {
          "name": "CMD 186 - LTE Radio and Cell Diagnostics",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "text/plain, */*; q=0.01"
              },
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "Referer",
                "value": "{{baseUrl}}/mindex.html"
              },
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"POST\",\n  \"cmd\": 186,\n  \"atcmd\": [\n    \"AT+TZEARFCN?\",\n    \"AT+TZBAND?\",\n    \"AT+TZBANDWIDTH?\",\n    \"AT+TZTRANSMODE?\",\n    \"AT+TZRSRP?\",\n    \"AT+TZRSRQ?\",\n    \"AT+TZSINR?\",\n    \"AT+TZTA?\",\n    \"AT+TZTXPOWER?\",\n    \"AT+CEREG?\",\n    \"AT+TZGLBCELLID?\",\n    \"AT+TZPHYCELLID?\"\n  ],\n  \"language\": \"EN\",\n  \"sessionId\": \"{{sessionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cgi-bin/http.cgi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cgi-bin",
                "http.cgi"
              ]
            },
            "description": "Returns LTE diagnostics in message text: EARFCN, band, bandwidth, transmission mode, RSRP, RSRQ, SINR, timing advance, TX power, CEREG/TAC/ECI, global cell ID and physical cell ID (PCI). Observed RSRQ raw value -110 corresponds to UI -11 dB."
          }
        }
      ]
    }
