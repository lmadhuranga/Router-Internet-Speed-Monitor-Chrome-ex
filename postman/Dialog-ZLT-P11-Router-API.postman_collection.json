{
  "info": {
    "_postman_id": "b73b1a6a-41aa-4fc6-b6d1-zltp11routerapi",
    "name": "Dialog ZLT P11 Router API",
    "description": "Postman collection for APIs verified on Dialog Sri Lanka ZLT P11 Outdoor LTE CPE (Software 40.8 / Sri Lanka Dialog V9.8). Uses placeholders only; do not commit live session IDs, cookies, router credentials, Wi-Fi passwords, IMEI/IMSI/ICCID, or other secrets.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://192.168.8.1"
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "passwordHash",
      "value": ""
    },
    {
      "key": "mac",
      "value": "AA:BB:CC:DD:EE:FF"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "CMD 100 - Authenticate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "text/plain, */*; q=0.01"
              },
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "Referer",
                "value": "{{baseUrl}}/mindex.html"
              },
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cmd\": 100,\n  \"method\": \"POST\",\n  \"sessionId\": \"{{sessionId}}\",\n  \"username\": \"{{username}}\",\n  \"passwd\": \"{{passwordHash}}\",\n  \"language\": \"EN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cgi-bin/http.cgi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cgi-bin",
                "http.cgi"
              ]
            },
            "description": "Authenticates with the router. Replace variables locally; do not save real credentials in source control."
          }
        }
      ]
    },
    {
      "name": "Router Status",
      "item": [
        {
          "name": "CMD 0 - Router Status / WAN Counters",
          "request": {
