            "header": [
              {
                "key": "Accept",
                "value": "text/plain, */*; q=0.01"
              },
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "Referer",
                "value": "{{baseUrl}}/mindex.html"
              },
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cmd\": 0,\n  \"method\": \"GET\",\n  \"language\": \"EN\",\n  \"sessionId\": \"{{sessionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cgi-bin/http.cgi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cgi-bin",
                "http.cgi"
              ]
            },
            "description": "Returns status fields used by Router Monitor such as RSSI, WAN RX/TX bytes, WAN IP, gateway, PLMN and uptime."
          }
        }
      ]
    },
    {
      "name": "Wi-Fi",
      "item": [
        {
          "name": "CMD 117 - Read Wi-Fi Configuration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "text/plain, */*; q=0.01"
              },
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "Referer",
                "value": "{{baseUrl}}/mindex.html"
              },
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cmd\": 117,\n  \"method\": \"GET\",\n  \"language\": \"EN\",\n  \"sessionId\": \"{{sessionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cgi-bin/http.cgi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cgi-bin",
                "http.cgi"
              ]
            },
            "description": "Observed response is comma-separated text. macinfo_broadcast=0 means SSID visible; 1 means hidden."
          }
        },
        {
          "name": "CMD 117 - Update Wi-Fi Visibility (Template)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "text/plain, */*; q=0.01"
              },
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              },
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "Referer",
                "value": "{{baseUrl}}/mindex.html"
              },
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cmd\": 117,\n  \"method\": \"POST\",\n  \"datas\": [\n    {\n      \"ipMacId\": \"-1\",\n      \"macinfo_mac\": \"<PRESERVE_FROM_GET>\",\n      \"macinfo_ip\": \"<PRESERVE_FROM_GET>\",\n      \"macinfo_wifiOpen\": \"<PRESERVE_FROM_GET>\",\n      \"macinfo_ssid\": \"<PRESERVE_FROM_GET>\",\n      \"macinfo_rts\": \"<PRESERVE_FROM_GET>\",\n      \"macinfo_txPower\": \"<PRESERVE_FROM_GET>\",\n      \"macinfo_channel\": \"<PRESERVE_FROM_GET>\",\n      \"macinfo_wifiWorkMode\": \"<PRESERVE_FROM_GET>\",\n      \"macinfo_security_config\": \"<PRESERVE_FROM_GET>\",\n      \"macinfo_pwd\": \"<PRESERVE_FROM_GET>\",\n      \"macinfo_broadcast\": \"0\",\n      \"cmd\": 2,\n      \"method\": \"POST\",\n      \"secMode\": \"<PRESERVE_FROM_GET>\",\n      \"secFile\": \"<PRESERVE_FROM_GET>\",\n      \"cypher\": \"<PRESERVE_FROM_GET>\",\n      \"wpa\": \"<PRESERVE_FROM_GET>\",\n      \"debug\": \"0\",\n      \"groupRekey\": \"<PRESERVE_FROM_GET>\",\n      \"gmkRekey\": \"<PRESERVE_FROM_GET>\",\n      \"pskKey\": \"<PRESERVE_FROM_GET>\",\n      \"chMode\": \"<PRESERVE_FROM_GET>\",\n      \"pureg\": \"<PRESERVE_FROM_GET>\",\n      \"puren\": \"<PRESERVE_FROM_GET>\",\n      \"rateCtl\": \"<PRESERVE_FROM_GET>\",\n      \"manRate\": \"<PRESERVE_FROM_GET>\",\n      \"manRetries\": \"<PRESERVE_FROM_GET>\"\n    }\n  ],\n  \"language\": \"EN\",\n  \"sessionId\": \"{{sessionId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cgi-bin/http.cgi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cgi-bin",
                "http.cgi"
              ]
            },
            "description": "Template only. Read CMD 117 first and preserve all existing Wi-Fi fields. Change macinfo_broadcast only: 0=visible, 1=hidden."
          }
        }
      ]
    },
