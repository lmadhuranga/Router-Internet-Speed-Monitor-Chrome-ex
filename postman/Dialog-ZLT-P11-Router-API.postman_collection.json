              "raw": "{{baseUrl}}/cgi-bin/http.cgi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cgi-bin",
                "http.cgi"
              ]
            },
            "description": "Example deletion flow: omit the unwanted rule from datas and send the remaining complete rule list. Then run CMD 20."
          }
        },
