    {
      "name": "Access Rules",
      "item": [
        {
          "name": "CMD 23 - Read Current Access Rules",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "text/plain, */*; q=0.01"
              },
              {
                "key": "Content-Type",
                "value": "application/json; charset=UTF-8"
              },
              {
                "key": "Origin",
