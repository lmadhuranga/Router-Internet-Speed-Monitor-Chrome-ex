{
  "manifest_version": 3,
  "name": "Router Internet Speed Monitor",
  "version": "1.1.0",
  "description": "Monitor router speed, signal strength and connection information.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://192.168.8.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Router Speed",
    "default_popup": "popup.html"
  }
}